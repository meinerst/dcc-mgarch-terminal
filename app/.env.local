# Live mode is the only mode this repository ships.
#
# `compute/datasource.js` defaults to "canned", which replays a pre-recorded payload
# from app/public/data/. Those payloads are deploy-only and are not part of this
# repository, so without this file a fresh clone would start the desk and immediately
# fail fetching /data/manifest.json.
#
# Setting it here means `npm run dev` works on its own, without going through
# start.bat / start.sh. Both launchers set the same value.
#
# Live mode needs the Python runner alongside the frontend:
#   python -m dccmgarch.serving.live_server
NEXT_PUBLIC_DATA_MODE=live
